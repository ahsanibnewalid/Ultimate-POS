APP_NAME="Ultimate POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:3000
BILLING_FRONTEND_URL=http://localhost:3000
LOG_CHANNEL=stderr
LOG_LEVEL=debug
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ultimate_pos
DB_USERNAME=pos
DB_PASSWORD=local-dev-only-change-me
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Optional SaaS billing gateways. Keep real keys only in server-side .env/secrets.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
STRIPE_LIVE_MODE=false
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# Preferred: comma-separated user IDs for platform operators (set after creating their account).
PLATFORM_ADMIN_USER_IDS=
# Alternative: verified email addresses only; unverified emails are never sufficient.
PLATFORM_ADMIN_EMAILS=
