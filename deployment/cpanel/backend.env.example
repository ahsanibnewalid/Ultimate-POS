# Copy these values into backend/.env on the cPanel server.
# Replace every placeholder; never commit real production values.
APP_NAME="Ultimate POS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
FRONTEND_URL=https://example.com,https://www.example.com
LOG_CHANNEL=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CPANELPREFIX_pos
DB_USERNAME=CPANELPREFIX_posuser
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Payment gateways: set credentials only after merchant approval; never commit live values.
# Stripe requires an eligible Stripe merchant account and a configured webhook endpoint.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
# Bangladesh payments: use SSLCommerz sandbox until merchant live credentials are issued.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
